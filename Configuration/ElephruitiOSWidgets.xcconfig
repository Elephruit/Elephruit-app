// The widget extension's build settings — the whole file, on the same argument as the two app
// xcconfigs beside it: the `pbxproj` stays small and is touched only when a target appears.
//
// A sibling rather than an `#include` of `ElephruitiOS.xcconfig` for the reason that file gives
// for not including the macOS one: it states `INFOPLIST_FILE`, `CODE_SIGN_ENTITLEMENTS` and an
// application's `PRODUCT_BUNDLE_IDENTIFIER`, and an extension that inherited any of those and
// then overrode them is an extension somebody will one day forget to override.

// MARK: - Identity

PRODUCT_NAME = ElephruitiOSWidgets
// The app's identifier plus one component, which is what the system requires of an extension it
// is going to load inside that app.
PRODUCT_BUNDLE_IDENTIFIER = com.elephruit.ElephruitMemory.iOS.Widgets
PRODUCT_MODULE_NAME = ElephruitiOSWidgets
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Platform

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
// Both families, because the host app is both. An extension narrower than its host still builds
// and still installs — a subset is legal — but it means an iPad running this app would start a
// Live Activity the device has no interface to draw, and `Activity.request` would fail into a log
// line nobody reads. The activity's view is plain SwiftUI and has nothing phone-shaped in it.
TARGETED_DEVICE_FAMILY = 1,2
ARCHS = $(ARCHS_STANDARD)

// MARK: - Swift

SWIFT_VERSION = 6.0
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_EMIT_LOC_STRINGS = YES

// MARK: - Bundle

INFOPLIST_FILE = Configuration/ElephruitiOSWidgets-Info.plist
GENERATE_INFOPLIST_FILE = YES
// No entitlements file. A Live Activity started by the app it ships inside needs none, and an
// entitlement lands in the same commit as the feature that needs it — the rule the two app
// entitlement files already keep.
//
// Said out loud rather than left unsaid, because "unset" and "empty" are the same thing to the
// build system only until something above sets it. For one release they were not the same: the
// project-level configurations named the *macOS* xcconfig as their base, so a target that stayed
// quiet here inherited `Configuration/Elephruit.entitlements` — sandbox, iCloud, silent pushes and
// a team-prefixed App Group — and this extension asked the portal for capabilities no iOS wildcard
// profile carries, in a form ("6YXGZMLWFB.com.elephruit.ElephruitMemory") the portal rejects
// outright because iOS groups must start with `group.`. The project file no longer inherits from a
// platform; this line means the claim above survives if it ever does again.
CODE_SIGN_ENTITLEMENTS =
SKIP_INSTALL = YES

// MARK: - Linking

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks

// MARK: - Signing

#include "Signing.xcconfig"
CODE_SIGN_STYLE = Automatic
