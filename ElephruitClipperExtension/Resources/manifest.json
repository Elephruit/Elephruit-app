{
  "manifest_version": 3,
  "name": "Elephruit Web Clipper",
  "description": "Keep articles, selections, pages, bookmarks, and screenshots in your local Elephruit library.",
  "version": "0.3.3",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Clip to Elephruit",
    "default_popup": "popup.html",
    "default_icon": "elephruit-icon.png"
  }
}
