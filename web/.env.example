# Copy to .env and fill in to run against a real Firebase project.
# With no .env at all, dev runs fully offline against the local emulators
# under the fictional project id "demo-elephruit".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "false" to make `npm run dev` talk to the real project instead of the
# emulators. Production builds never use the emulators.
VITE_USE_EMULATORS=

# App Check (reCAPTCHA v3). The site key is public and required for production
# builds; the debug token is minted in the App Check console for local dev
# against the real project. Emulator runs ignore both.
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
