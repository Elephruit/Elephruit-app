# Copy to .env.local (which is gitignored and never deployed) for emulator work.
#
# Key material for the development encryption service — any long random value,
# e.g. `openssl rand -hex 32`. Emulator-only: its presence in production fails
# startup. Rotating it orphans locally encrypted credentials, which is fine;
# re-link the test key in Settings.
DEV_ENCRYPTION_KEY=

# Serve canned provider responses instead of calling api.anthropic.com, so the
# whole AI loop runs offline. Emulator-only, same startup enforcement.
AI_FAKE_ADAPTER=1
